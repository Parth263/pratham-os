# Copy to .env.local for local development. In Vercel, set these under
# Project → Settings → Environment Variables.

# Your one login password. Pick something long.
APP_PASSWORD=

# Signs the login cookie. At least 32 random characters, e.g. `openssl rand -base64 48`.
# Changing it (or APP_PASSWORD) signs every device out.
AUTH_SECRET=

# Postgres connection string. The Neon integration in the Vercel Marketplace sets these
# for you. Leave empty locally to use the embedded dev database in .data/.
DATABASE_URL=
# Optional: direct (non-pooled) URL, used only for migrations.
DATABASE_URL_UNPOOLED=
